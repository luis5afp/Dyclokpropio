{
  "manifest_version": 3,
  "name": "MP4 to Y4M Converter",
  "version": "1.0.1",
  "description": "Convert MP4 files to Y4M for Chrome fake video capture",
  "key": "",
  "permissions": ["storage", "tabs", "activeTab", "notifications"],
  "host_permissions": ["http://127.0.0.1:27777/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "To replace the browser's video stream, please upload an MP4 video.",
    "default_icon": {
      "16": "icons/camera-16.png",
      "32": "icons/camera-32.png",
      "48": "icons/camera-48.png",
      "128": "icons/camera-128.png"
    }
  },
  "icons": {
    "16": "icons/camera-16.png",
    "32": "icons/camera-32.png",
    "48": "icons/camera-48.png",
    "128": "icons/camera-128.png"
  }
}
